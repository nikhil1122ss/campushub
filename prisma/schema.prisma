generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  image         String?
  emailVerified DateTime?
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  referrals     Referral[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Product {
  id            String   @id @default(cuid())
  name          String
  category      String
  description   String
  brand         String
  costPrice     Float
  sellingPrice  Float
  profitMargin  Float
  quantity      Int
  image         String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  orders        OrderItem[]
  discounts     Discount[]
}

model Order {
  id              String      @id @default(cuid())
  user            User?       @relation(fields: [userId], references: [id])
  userId          String?
  studentName     String
  college         String
  branch          String
  year            String
  hostelRoom      String
  mobile          String
  deliveryAddress String
  paymentMethod   String
  deliveryOption  String
  status          String      @default("Order Placed")
  deliveryCharge  Float       @default(50)
  totalAmount     Float
  createdAt       DateTime    @default(now())
  items           OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  quantity  Int
  price     Float
}

model Discount {
  id         String   @id @default(cuid())
  code       String   @unique
  description String
  amount     Float
  active     Boolean  @default(true)
  product    Product? @relation(fields: [productId], references: [id])
  productId  String?
}

model Request {
  id          String   @id @default(cuid())
  title       String
  description String
  createdAt   DateTime @default(now())
  status      String   @default("Pending")
}

model Referral {
  id           String   @id @default(cuid())
  code         String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  rewardPoints Int      @default(0)
}
